# Base de datos (docker-compose.yml y application.properties leen estas variables)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flyaway
DB_USER=postgres
DB_PASSWORD=postgres

# JWT: secreto en Base64 de al menos 256 bits (genera uno con: openssl rand -base64 32)
JWT_SECRET=Zmx5LWF3YXktdHJhdmVsLWRldi1zZWNyZXQta2V5LWNoYW5nZS1tZQ==
JWT_EXPIRATION_MS=3600000

# Carpeta donde se escriben los archivos flight_booking_email_${booking_id}.txt
BOOKING_EMAIL_DIR=.
